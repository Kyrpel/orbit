# Orbit reads these from the environment it is started in. None are required
# for local missions with the Claude Code CLI or scripted runtime.

# Where Orbit keeps its database, worktrees, cloned repos and tokens (default: ~/.orbit)
# ORBIT_HOME=

# API and dashboard port (default: 7420). Orbit always binds to 127.0.0.1.
# ORBIT_PORT=7420

# Claude Agent SDK runtime: an Anthropic API key, or a supported cloud provider.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1
# CLAUDE_CODE_USE_FOUNDRY=1

# Claude Code CLI runtime: path to `claude` if it is not on PATH.
# ORBIT_CLAUDE_BIN=

# Only read by `orbit asana connect` (the token is then stored in ORBIT_HOME/secrets.json).
# ORBIT_ASANA_TOKEN=

# Extra hostnames accepted in Host/Origin headers (comma-separated). Leave empty unless you know why.
# ORBIT_ALLOWED_HOSTS=

# debug | info | warn | error
# ORBIT_LOG_LEVEL=info
